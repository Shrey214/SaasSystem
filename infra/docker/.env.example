# Copy to .env in this folder. The real .env is gitignored.
#   cp infra/docker/.env.example infra/docker/.env
# up.ps1 does this for you on first run.

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_dev_only_change_me
# 5433, not 5432, on purpose. A locally installed PostgreSQL commonly binds
# 127.0.0.1:5432, and it WINS over docker's 0.0.0.0 binding for anything
# connecting to "localhost" - so the app silently reaches the wrong server
# and reports "password authentication failed" for a user that exists.
# Change only if 5433 is also taken.
POSTGRES_PORT=5433

# Password given to all 13 hs_<service>_user roles.
# One shared password is a deliberate local shortcut - in a real
# deployment each service gets its own secret. Avoid quotes and
# backslashes: this value is interpolated into SQL by the init scripts.
HS_SERVICE_PASSWORD=local_dev_only_change_me

# --- pgAdmin ------------------------------------------------------------
PGADMIN_EMAIL=admin@hotelsaas.dev
PGADMIN_PASSWORD=local_dev_only_change_me
PGADMIN_PORT=5050

# --- services -----------------------------------------------------------
TENANT_API_PORT=5101
