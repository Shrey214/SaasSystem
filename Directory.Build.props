<Project>

  <!--
    Applies to every .csproj under this folder. One place to change the
    framework, language level and analysis rules for all services.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Warnings are errors on purpose. In a system with 14 services, a
      warning nobody reads becomes a nullable-reference bug in a booking
      transaction six months later.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!--
      Code STYLE (IDE0xxx) is deliberately not enforced in the build.
      .editorconfig + the IDE + `dotnet format` handle formatting; making
      a misplaced brace fail the build costs more than it saves. Real
      analyzer findings (CAxxxx) are still errors.
    -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!--
      CA1716 flags type names that clash with keywords in OTHER CLR
      languages - it objects to `Error` because VB has an Error statement.
      This codebase is C# only, and `Error` is the conventional name in the
      Result pattern. Suppressed deliberately, not because it was noisy.
    -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      RestorePackagesWithLockFile is switched on at stage 24, with CI.
      While projects and packages are still being added every few minutes
      it just produces NU1004 "lock file out of date" on every change.
    -->
  </PropertyGroup>

  <PropertyGroup>
    <!--
      We only ever run on Linux containers and en-US formatting; opting
      out of ICU keeps images smaller and behaviour identical everywhere.
      Revisit if we ever localise the guest-facing site.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
